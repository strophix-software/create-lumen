{
  "name": "create-lumen",
  "version": "2.0.0-beta.4",
  "description": "Scaffold a React + Vite or Next.js project with architecture choice: feature-based, type-based, or none.",
  "type": "module",
  "bin": {
    "create-lumen": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strophix-software/create-lumen"
  },
  "files": [
    "bin/",
    "register.js",
    "src/",
    "templates/",
    "skills/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen:schema": "node scripts/generate-schema.mjs",
    "test": "node --import ./register.js --test \"tests/unit/*.test.mjs\" \"tests/smoke/*.test.mjs\"",
    "verify:vendor": "node --import ./register.js tests/verify/install-vendor.mjs",
    "verify:offline": "node --import ./register.js tests/verify/verify-offline.mjs",
    "verify:installed": "node --import ./register.js tests/verify/verify-installed.mjs",
    "verify": "npm run verify:vendor && npm run verify:offline",
    "verify:full": "npm run verify:vendor && npm run verify:offline && npm run verify:installed",
    "verify:matrix": "FULL=1 npm run verify:offline"
  },
  "keywords": [
    "scaffold",
    "create",
    "cli",
    "vite",
    "react",
    "typescript",
    "feature-based",
    "type-based",
    "architecture",
    "starter",
    "boilerplate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2",
    "execa": "^9.6.0",
    "zod": "4.6.5",
    "zod-validation-error": "4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
