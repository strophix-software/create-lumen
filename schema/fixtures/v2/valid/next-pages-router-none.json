{
  "$schema": "https://lumen-sh.github.io/create-lumen/schema/lumen.config.v2.json",
  "manifestVersion": 2,
  "framework": {
    "name": "next",
    "variant": "pages-router"
  },
  "styling": {
    "engine": "none"
  },
  "architecture": {
    "type": "none"
  },
  "ui": {
    "kit": "none"
  },
  "docs": {
    "language": "en"
  },
  "paths": {
    "features": "src",
    "components": "src/components",
    "services": "src/services",
    "hooks": "src/hooks",
    "pages": "src/pages",
    "ui": "src/components/ui"
  },
  "tooling": {
    "language": "ts",
    "linter": "none",
    "formatter": "none"
  }
}
